# Database
DATABASE_URL="postgresql://user:password@localhost:5432/manpower?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/manpower?schema=public"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_PROJECT_REF="your-project-ref"

# App
PORT=3001
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_API_VERSION="v18.0"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_ACCOUNT_NUMBER="your-account-number"

# GST
DEFAULT_GST_RATE=0.18

# Invoicing
INVOICE_DUE_DAYS=30
DEFAULT_HOURLY_RATE=200
