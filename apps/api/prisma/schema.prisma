// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  WORKER
  OPS_ADMIN
}

enum SkillTag {
  GENERAL_HELPER
  FORKLIFT_MHE
  SCANNER_TRAINED
  COLD_STORAGE
}

enum RequestStatus {
  DRAFT
  OPEN
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  NO_SHOW
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String?  @unique
  phone      String?  @unique
  role       UserRole
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company?
  worker  Worker?
}

model Company {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String
  gstNumber    String?
  address      String?
  contactName  String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites    Site[]
  requests Request[]
  invoices Invoice[]
}

model Site {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String
  lat          Float
  lng          Float
  radiusMeters Int      @default(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests Request[]
  checkIns CheckIn[]
}

model Worker {
  id            String     @id @default(cuid())
  userId        String?    @unique
  user          User?      @relation(fields: [userId], references: [id])
  name          String
  phone         String     @unique
  whatsappOptIn Boolean    @default(true)
  photoUrl      String?
  skills        SkillTag[]
  kycStatus     KycStatus  @default(PENDING)
  kycDocUrls    String[]
  isActive      Boolean    @default(true)

  // Reliability computed fields (updated via trigger / cron)
  reliabilityScore     Float @default(100.0)
  totalShiftsOffered   Int   @default(0)
  totalShiftsAccepted  Int   @default(0)
  totalShiftsCompleted Int   @default(0)
  totalNoShows         Int   @default(0)
  avgPunctualityMins   Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers   ShiftOffer[]
  checkIns CheckIn[]
  payouts  Payout[]
}

model Request {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  siteId        String
  site          Site          @relation(fields: [siteId], references: [id])
  title         String
  date          DateTime
  shiftStart    String // "HH:MM" 24h
  shiftEnd      String // "HH:MM" 24h
  headcount     Int
  skillTags     SkillTag[]
  status        RequestStatus @default(OPEN)
  isRecurring   Boolean       @default(false)
  recurringDays Int[] // 0=Sun..6=Sat
  notes         String?

  // Overbooking / fill tracking
  targetHeadcount     Int
  offerBuffer         Int   @default(0)
  fillRateThreshold   Float @default(0.95)
  guaranteedHeadcount Int
  bookedHeadcount     Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers   ShiftOffer[]
  checkIns CheckIn[]
  invoices Invoice[]
}

model ShiftOffer {
  id            String      @id @default(cuid())
  requestId     String
  request       Request     @relation(fields: [requestId], references: [id])
  workerId      String
  worker        Worker      @relation(fields: [workerId], references: [id])
  status        OfferStatus @default(PENDING)
  offeredAt     DateTime    @default(now())
  respondedAt   DateTime?
  whatsappMsgId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, workerId])
}

model CheckIn {
  id                  String    @id @default(cuid())
  workerId            String
  worker              Worker    @relation(fields: [workerId], references: [id])
  requestId           String
  request             Request   @relation(fields: [requestId], references: [id])
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id])
  checkInAt           DateTime
  checkInLat          Float
  checkInLng          Float
  checkInSelfieUrl    String?
  checkOutAt          DateTime?
  checkOutLat         Float?
  checkOutLng         Float?
  hoursWorked         Float?
  isVerified          Boolean   @default(false)
  punctualityMins     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLineItems InvoiceLineItem[]
}

model Invoice {
  id                      String        @id @default(cuid())
  companyId               String
  company                 Company       @relation(fields: [companyId], references: [id])
  requestId               String
  request                 Request       @relation(fields: [requestId], references: [id])
  invoiceNumber           String        @unique
  status                  InvoiceStatus @default(DRAFT)
  issuedAt                DateTime?
  dueAt                   DateTime?
  subtotal                Float
  gstAmount               Float
  total                   Float
  gstRate                 Float         @default(0.18)
  hourlyRate              Float
  razorpayPaymentLinkId   String?
  razorpayPaymentLinkUrl  String?
  pdfUrl                  String?

  // Booked vs billed for the ROI story
  bookedHeadcount Int
  billedHeadcount Int
  bookedHours     Float
  billedHours     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  checkInId  String
  checkIn    CheckIn  @relation(fields: [checkInId], references: [id])
  workerName String
  skillTag   SkillTag
  hours      Float
  hourlyRate Float
  amount     Float
  date       DateTime

  createdAt DateTime @default(now())
}

model Payout {
  id               String       @id @default(cuid())
  workerId         String
  worker           Worker       @relation(fields: [workerId], references: [id])
  amount           Float
  hoursWorked      Float
  hourlyRate       Float
  shiftDate        DateTime
  status           PayoutStatus @default(PENDING)
  razorpayPayoutId String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
