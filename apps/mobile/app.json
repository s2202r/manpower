{
  "expo": {
    "name": "Taim",
    "slug": "taim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f48512"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "space.taim.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f48512"
      },
      "package": "space.taim.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "taim"
  }
}
