# ============================================================
# Manpower Monorepo — .gitignore
# Node / Next.js / Expo / NestJS / Prisma / Turborepo
# ============================================================

# ------------------------------------
# Dependencies
# ------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------
# Build outputs
# ------------------------------------
dist/
build/
out/
.output/

# Next.js
.next/
next-env.d.ts

# Expo / React Native
web-build/
android/
ios/
.expo/
*.jsbundle

# NestJS compiled output
apps/api/dist/

# Shared package compiled output
packages/shared/dist/
packages/*/dist/

# TypeScript incremental build info
*.tsbuildinfo

# ------------------------------------
# Environment / secrets
# ------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.envrc

# Keep examples in version control
!.env.example
!.env.local.example

# ------------------------------------
# Logs
# ------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------
# OS
# ------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------
# Editors / IDEs
# ------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------
# Prisma
# ------------------------------------
# Generated client (regenerated via `prisma generate`)
apps/api/node_modules/.prisma/

# Migrations are committed; ignore the local shadow DB
apps/api/prisma/dev.db
apps/api/prisma/dev.db-journal

# ------------------------------------
# Expo / React Native code signing
# ------------------------------------
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
expo-env.d.ts

# ------------------------------------
# Turborepo
# ------------------------------------
.turbo/

# ------------------------------------
# Test coverage
# ------------------------------------
coverage/
.nyc_output/
lcov.info

# ------------------------------------
# Supabase local dev
# ------------------------------------
supabase/.branches/
supabase/.temp/

# ------------------------------------
# Docker
# ------------------------------------
.dockerignore
docker-compose.override.yml

# ------------------------------------
# Misc
# ------------------------------------
.cache/
tmp/
*.tmp
*.bak
